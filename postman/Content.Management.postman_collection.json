                "url": "{{baseUrl}}/api/content-management/events",
                "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{orgUsername}}", "type": "string" }, { "key": "password", "value": "{{orgPassword}}", "type": "string" } ] }
              },
