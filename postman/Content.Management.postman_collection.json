                "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{userUsername}}", "type": "string" }, { "key": "password", "value": "{{userPassword}}", "type": "string" } ] }
              },
              "response": []
            },
            {
              "name": "3. Get {{scenarioCornerId}} (admin) → 200, unpublished, version 2",
              "event": [
                { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });", "pm.test(\"isPublished is false\", function () { pm.expect(pm.response.json().isPublished).to.eql(false); });", "pm.test(\"version is 2\", function () { pm.expect(pm.response.json().version).to.eql(2); });" ] } }
              ],
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/content-management/entities/{{scenarioCornerId}}",
