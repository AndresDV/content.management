        {
          "name": "S4. Corner case — unpublish of a never-published version",
          "description": "The CMS modifies an entity to version 2 but never publishes it; then sends an unpublish for version 2. The entity must be persisted as unpublished (latest version tracked), hidden from users, visible to admins.",
          "item": [
            {
              "name": "1. Unpublish {{scenarioCornerId}} (v2) — never published",
              "event": [
                { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });" ] } }
