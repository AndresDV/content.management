    {
      "name": "5. Scenarios (ordered, self-verifying)",
      "description": "Ordered request sequences that replicate the assessment's business-rule scenarios. Run each sub-folder top-to-bottom (via the Runner); every request asserts the expected outcome.",
      "item": [
        {
          "name": "S1. Publish → visible",
          "item": [
            {
              "name": "1. Publish {{scenarioPublishId}} (v1)",
              "event": [
                { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });" ] } }
              ],
              "request": {
                "method": "POST",
                "header": [ { "key": "Content-Type", "value": "application/json" } ],
                "body": { "mode": "raw", "raw": "[{\"type\":\"publish\",\"id\":\"{{scenarioPublishId}}\",\"payload\":{\"name\":\"Published\"},\"version\":1}]", "options": { "raw": { "language": "json" } } },
                "url": "{{baseUrl}}/api/content-management/events",
                "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{orgUsername}}", "type": "string" }, { "key": "password", "value": "{{orgPassword}}", "type": "string" } ] }
              },
              "response": []
            },
            {
              "name": "2. Get {{scenarioPublishId}} (user) → 200, version 1, published",
              "event": [
                { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });", "pm.test(\"version is 1\", function () { pm.expect(pm.response.json().version).to.eql(1); });", "pm.test(\"isPublished is true\", function () { pm.expect(pm.response.json().isPublished).to.eql(true); });" ] } }
              ],
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/content-management/entities/{{scenarioPublishId}}",
                "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{userUsername}}", "type": "string" }, { "key": "password", "value": "{{userPassword}}", "type": "string" } ] }
